{
  "name": "@ignitify-integrations/s3-storage",
  "version": "0.1.1",
  "description": "Store files from an ignitify task in any S3-compatible bucket and return presigned links",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignitify-dev/ignitify-integrations.git",
    "directory": "integrations/s3-storage"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "integration.yaml",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@ignitify-integrations/runtime": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
